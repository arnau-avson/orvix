# ============================================================
# px4-sitl: PX4 Software-In-The-Loop headless simulator
# ============================================================
# Runs PX4 SITL without Gazebo GUI (headless mode).
# Simulates drone physics and exposes MAVLink over UDP.
#
# Usage:
#   docker compose up px4-sitl
# ============================================================

FROM ubuntu:22.04

LABEL maintainer="arnau"
LABEL description="PX4 SITL headless simulator for WarDrone testing"

ENV DEBIAN_FRONTEND=noninteractive
ENV PX4_HOME=/root/PX4-Autopilot
ENV HEADLESS=1
ENV PX4_SIM_HOST_ADDR=0.0.0.0

# ---- System dependencies ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    ca-certificates \
    build-essential \
    cmake \
    ninja-build \
    python3 \
    python3-pip \
    python3-dev \
    python3-jinja2 \
    python3-numpy \
    python3-toml \
    python3-empy \
    python3-packaging \
    python3-jsonschema \
    python3-yaml \
    libxml2-dev \
    libxslt1-dev \
    lsb-release \
    unzip \
    astyle \
    gdb \
    lcov \
    libgtest-dev \
    && rm -rf /var/lib/apt/lists/*

# ---- Python deps for PX4 build ----
RUN pip3 install --no-cache-dir \
    kconfiglib \
    pyros-genmsg \
    future \
    cerberus \
    setuptools

# ---- Clone PX4 ----
# Use --depth 1 for speed, then fetch tags needed by the version script
RUN git clone --depth 1 --branch v1.15.4 \
    https://github.com/PX4/PX4-Autopilot.git ${PX4_HOME} \
    && cd ${PX4_HOME} \
    && git fetch --tags --depth 1 \
    && git submodule update --init --recursive --depth 1

# ---- Patch version script for shallow clone compatibility ----
# The px_update_git_header.py script crashes when nuttx git tags are
# unavailable (shallow submodule clone). This patches it to handle
# the missing tags gracefully.
COPY scripts/patch_px4_version.py /tmp/patch_px4_version.py
RUN sed -i 's/\r$//' /tmp/patch_px4_version.py && python3 /tmp/patch_px4_version.py ${PX4_HOME}

# ---- Build PX4 SITL (headless, no Gazebo) ----
WORKDIR ${PX4_HOME}
RUN DONT_RUN=1 make px4_sitl_default

# ---- Enable MAVLink broadcast for Docker networking ----
# PX4 defaults to localhost-only. Append broadcast params to the SIH airframe
# so other containers on the Docker network can receive MAVLink.
RUN echo 'param set MAV_0_BROADCAST 1' >> ${PX4_HOME}/build/px4_sitl_default/etc/init.d-posix/airframes/10040_sihsim_quadx \
    && echo 'param set MAV_1_BROADCAST 1' >> ${PX4_HOME}/build/px4_sitl_default/etc/init.d-posix/airframes/10040_sihsim_quadx

# ---- Expose MAVLink ports ----
# 14540: MAVSDK default
# 14550: QGroundControl default
# 18570: uXRCE-DDS
EXPOSE 14540/udp
EXPOSE 14550/udp
EXPOSE 18570/udp

# ---- Startup script ----
COPY scripts/start_px4_sitl_docker.sh /start_sitl.sh
RUN sed -i 's/\r$//' /start_sitl.sh && chmod +x /start_sitl.sh

CMD ["/start_sitl.sh"]
