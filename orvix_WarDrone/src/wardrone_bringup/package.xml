<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wardrone_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, configuration, and mission files for the WarDrone</description>
  <maintainer email="arnau@todo.todo">arnau</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>wardrone_interfaces</exec_depend>
  <exec_depend>wardrone_driver</exec_depend>
  <exec_depend>wardrone_navigation</exec_depend>
  <exec_depend>wardrone_vio</exec_depend>
  <exec_depend>wardrone_vision</exec_depend>
  <exec_depend>wardrone_mission</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
